# FMT-CONTRACT (BB-18): --template output must end with a trailing newline so
# piped consumers and terminals get a clean line break. The grep regex anchors
# on a full line, which only matches when the rendered value is newline-
# terminated.
bb-fake server

bitbottle pr view 1 -R $BB_HOST/PROJ/alpha-repo -k --template '{{.title}}'
stdout '^Fix the bug$'
