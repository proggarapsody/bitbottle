# FMT-CONTRACT (BB-17): --jq WITH --json must apply correctly on pr view and
# repo view — not be silently ignored. Each extracts a single field value.
bb-fake server

# pr view --json --jq .title → bare field value
bitbottle pr view 1 -R $BB_HOST/PROJ/alpha-repo -k --json --jq .title
stdout '^"Fix the bug"$'

# repo view --json --jq .slug → bare field value
bitbottle repo view -R $BB_HOST/PROJ/alpha-repo -k --json --jq .slug
stdout '^"alpha-repo"$'
